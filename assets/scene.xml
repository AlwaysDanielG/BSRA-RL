<mujoco model="bsra_cartpole">
  <compiler angle="degree"/>

  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>

  <default>
    <geom contype="0" conaffinity="0"/>
  </default>

  <include file="cartpole.xml"/>

  <worldbody>
    <light name="top" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.1"
          rgba="0.85 0.85 0.85 1"/>

    <geom name="rail" type="capsule" fromto="-1.4 0 0.20 1.4 0 0.20"
          size="0.02" rgba="0.4 0.4 0.4 1"/>

    <camera name="side" pos="0 -3.5 1.2" xyaxes="1 0 0 0 0.35 1"/>
  </worldbody>
</mujoco>
