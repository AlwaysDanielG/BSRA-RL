<mujocoinclude>
  <worldbody>
    <body name="cart" pos="0 0 0.20">
      <joint name="slider" type="slide" axis="1 0 0"
             limited="true" range="-1.25 1.25" damping="1"/>
      <geom name="cart_geom" type="box" size="0.15 0.10 0.08"
            mass="10" rgba="0.25 0.45 0.75 1"/>
      <body name="pole" pos="0 0 0.08">
        <joint name="hinge" type="hinge" axis="0 1 0"
               limited="true" range="-90 90" damping="1"/>
        <geom name="pole_geom" type="capsule" fromto="0 0 0 0 0 0.75"
              size="0.04" mass="5" rgba="0.85 0.55 0.20 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="cart_motor" joint="slider"
           ctrllimited="true" ctrlrange="-3 3" gear="100"/>
  </actuator>
</mujocoinclude>
